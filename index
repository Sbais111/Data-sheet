<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Test Data Sheet Builder</title>

<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<style>

body{
font-family:Segoe UI,sans-serif;
background:#f4f6f8;
margin:0;
padding:0;
}

header{
background:#2563eb;
color:white;
padding:20px;
text-align:center;
}

.container{
max-width:1200px;
margin:auto;
padding:20px;
display:grid;
grid-template-columns:300px 1fr;
gap:20px;
}

.card{
background:white;
padding:20px;
border-radius:12px;
box-shadow:0 2px 6px rgba(0,0,0,.1);
}

input,
textarea{
width:100%;
padding:10px;
margin-top:5px;
margin-bottom:15px;
border:1px solid #ccc;
border-radius:8px;
}

button{
background:#2563eb;
color:white;
border:none;
padding:10px 15px;
border-radius:8px;
cursor:pointer;
}

button:hover{
opacity:.9;
}

.question{
display:grid;
grid-template-columns:1fr 120px 100px;
gap:10px;
margin-bottom:10px;
}

.stat{
font-size:18px;
margin-bottom:10px;
}

.dark{
background:#111827;
color:white;
}

.dark .card{
background:#1f2937;
}

.dark input,
.dark textarea{
background:#374151;
color:white;
border:none;
}

@media(max-width:900px){
.container{
grid-template-columns:1fr;
}
}

</style>
</head>

<body>

<header>
<h1>📊 Test Data Sheet Builder</h1>
<p>Create Excel assessment spreadsheets instantly.</p>
</header>

<div class="container">

<div>

<div class="card">

<h3>Dashboard</h3>

<div class="stat">
Students:
<span id="studentCount">
0
</span>
</div>

<div class="stat">
Questions:
<span id="questionCount">
0
</span>
</div>

<div class="stat">
Total Marks:
<span id="totalMarks">
0
</span>
</div>

<button onclick="toggleDarkMode()">
Dark Mode
</button>

<hr>

<button onclick="exportWorkbook()">
Download XLSX
</button>

</div>

</div>

<div>

<div class="card">

<h2>Test Details</h2>

<input
id="testName"
placeholder="Unit A1 Test">

</div>

<div class="card">

<h2>Students</h2>

<textarea
id="studentList"
rows="6"
placeholder="One student per line"></textarea>

<button onclick="loadStudents()">
Load Students
</button>

</div>

<div class="card">

<h2>Questions</h2>

<div id="questionContainer">

</div>

<button onclick="addQuestion()">
+ Add Question
</button>

</div>

</div>

</div>

<script>

let students=[];
let questions=[];

function saveData(){

localStorage.setItem(
"testBuilder",
JSON.stringify({
students,
questions,
testName:
document.getElementById("testName").value
})
);

}

function loadData(){

const saved=
JSON.parse(
localStorage.getItem("testBuilder")
);

if(!saved) return;

students=saved.students||[];
questions=saved.questions||[];

document.getElementById("testName").value=
saved.testName||"";

renderQuestions();
updateStats();

}

function loadStudents(){

students=
document
.getElementById("studentList")
.value
.split("\n")
.filter(x=>x.trim()!="");

updateStats();
saveData();

}

function addQuestion(){

questions.push({
label:
"Question " +
(questions.length+1),
marks:1
});

renderQuestions();
updateStats();
saveData();

}

function renderQuestions(){

const div=
document.getElementById(
"questionContainer"
);

div.innerHTML="";

questions.forEach((q,index)=>{

const row=
document.createElement("div");

row.className="question";

row.innerHTML=`

<input
value="${q.label}"
onchange="
questions[${index}].label=this.value;
saveData();
">

<input
type="number"
value="${q.marks}"
onchange="
questions[${index}].marks=Number(this.value);
updateStats();
saveData();
">

<button
onclick="
questions.splice(${index},1);
renderQuestions();
updateStats();
saveData();
">

Delete

</button>

`;

div.appendChild(row);

});

}

function updateStats(){

document.getElementById(
"studentCount"
).textContent=students.length;

document.getElementById(
"questionCount"
).textContent=questions.length;

const total=
questions.reduce(
(a,b)=>a+b.marks,
0
);

document.getElementById(
"totalMarks"
).textContent=total;

}

function exportWorkbook(){

const workbook=
XLSX.utils.book_new();

const studentSheet=[
["Students"]
];

students.forEach(s=>{
studentSheet.push([s]);
});

const wsStudents=
XLSX.utils.aoa_to_sheet(
studentSheet
);

XLSX.utils.book_append_sheet(
workbook,
wsStudents,
"Students"
);

const questionSheet=[
["Question","Marks"]
];

questions.forEach(q=>{
questionSheet.push([
q.label,
q.marks
]);
});

const wsQuestions=
XLSX.utils.aoa_to_sheet(
questionSheet
);

XLSX.utils.book_append_sheet(
workbook,
wsQuestions,
"Questions"
);

const filename=
(
document.getElementById(
"testName"
).value
||
"Assessment"
)
+
".xlsx";

XLSX.writeFile(
workbook,
filename
);

}

function toggleDarkMode(){

document.body.classList.toggle(
"dark"
);

}

document
.getElementById("testName")
.addEventListener(
"input",
saveData
);

loadData();

</script>

</body>
</html>
